{
  "name": "nouvelle-creation",
  "version": "1.0.0",
  "description": "Application spirituelle complète - Web + Desktop",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:desktop": "cd apps/desktop && npm run dev:all",
    "build:web": "cd apps/web && npm run build",
    "build:desktop": "cd apps/desktop && npm run electron-build",
    "lint": "cd apps/web && npm run lint"
  }
}
