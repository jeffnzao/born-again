# Variables d'environnement optionnelles pour Nouvelle Création

# Mode développement (défaut: development)
VITE_ENV=development

# URL API (si intégration backend)
VITE_API_URL=http://localhost:3000

# Version de l'app
VITE_APP_VERSION=1.0.0

# Clé pour notifications (optionnel)
VITE_NOTIFICATION_KEY=
